{
  "name": "tabby-workspace",
  "version": "0.1.0",
  "description": "All-in-one workspace for Tabby: SSH connections and Docker sidebar, server panel (stats, logs, ports & tunnels, snippets, history, notes), server monitoring and smart backgrounds",
  "author": "marse11e",
  "keywords": [
    "tabby-plugin",
    "tabby",
    "ssh",
    "docker",
    "sidebar",
    "server-monitoring",
    "port-forwarding",
    "snippets",
    "background"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "webpack --progress --color",
    "watch": "webpack --progress --color --watch",
    "install-local": "npm run build && node scripts/install-local.js"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "ng2-charts": "^4.1.0",
    "clone-deep": "^4.0.1",
    "utils-decorators": "^2.0.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@angular/animations": "^15.2.0",
    "@angular/common": "^15.2.0",
    "@angular/core": "^15.2.0",
    "@angular/forms": "^15.2.0",
    "@angular/platform-browser": "^15.2.0",
    "@ng-bootstrap/ng-bootstrap": "^14.2.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.7",
    "html-loader": "^5.0.0",
    "rxjs": "^7.8.0",
    "tabby-core": "latest",
    "tabby-settings": "latest",
    "tabby-ssh": "latest",
    "tabby-terminal": "latest",
    "ts-loader": "^9.5.0",
    "typescript": "~4.9.5",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "@angular/cdk": "^15.2.0",
    "ngx-toastr": "^16.0.0",
    "tabby-electron": "latest"
  }
}
